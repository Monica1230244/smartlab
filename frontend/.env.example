# TESTLAB frontend configuration
# Copier ce fichier en .env localement, puis adapter les valeurs.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_KEY=votre_cle_publishable_ou_anon
VITE_SUPABASE_TABLE=smartlab_records

# true = utiliser les tables metier testlab_* au lieu de smartlab_records
VITE_SUPABASE_TYPED_TABLES=false

# true = connexion email/mot de passe Supabase Auth par employe
# Le code active deja ce mode par defaut si la variable est absente.
VITE_SUPABASE_AUTH=true